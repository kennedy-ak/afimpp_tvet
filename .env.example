# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Settings (SQLite - default)
# Uncomment the line below to use PostgreSQL instead
# DATABASE_URL=postgresql://user:password@host:port/database

# Email Settings (Production Configuration)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=admin@yourdomain.com

# Observo Log Shipping
OBSERVO_PROJECT_ID=your-project-id-here
OBSERVO_API_KEY=your-api-key-here

# OpenAI API (for Chatbot)
OPENAI_API_KEY=your-openai-api-key-here

# PostHog Analytics (https://posthog.com)
# Project API key: PostHog dashboard -> Settings -> Project -> Project API Key
POSTHOG_KEY=phc_your-project-api-key-here
POSTHOG_HOST=https://us.i.posthog.com
# Exclude staff/superusers from all tracking (recommended: True)
POSTHOG_EXCLUDE_STAFF=True
# Session recordings (replays). Flip to True to enable.
POSTHOG_SESSION_REPLAY=False

# Sentry (https://sentry.io) - error tracking + performance monitoring
# DSN from sentry.io -> Settings -> Projects -> Client Keys (DSN).
# Leave empty to keep Sentry disabled. Example:
# SENTRY_DSN=https://1234abc@o000000.ingest.sentry.io/1234567
SENTRY_DSN=
# Defaults to 'production' (or 'development' when DEBUG=True) if unset
SENTRY_ENVIRONMENT=
# Fraction of requests traced for performance monitoring (0.0-1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0
# Profiler sample rate (traces_sample_rate must also cover it); 0 disables
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Attach user id/username/email to error events
SENTRY_SEND_PII=True
# Browser session replays (0.0 = off, 1.0 = all sessions)
SENTRY_REPLAYS_SAMPLE_RATE=0.0
# Browser replays triggered by an error (1.0 = record every erroring session)
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.0
# Optional: release tag; defaults to git short SHA in deployments with .git
SENTRY_RELEASE=

# Security Settings (Production - set all to True when using HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_SECONDS=31536000
